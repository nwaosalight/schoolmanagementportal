rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // School branding (logo, stamp, signature): public read, school admin write
    match /schools/{sid}/branding/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.schoolId == sid
        && 'school_admin' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.roles
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
